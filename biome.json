{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!storybook-static",
      "!site/dist",
      "!coverage",
      "!src/styles/generated-css.ts",
      "!**/__screenshots__",
      "!.superpowers",
      "!.changeset"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "overrides": []
}
