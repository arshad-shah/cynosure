{
  "name": "@arshad-shah/cynosure",
  "version": "0.1.0",
  "description": "Cynosure: one small, themeable, accessible UI system for every Arshad Shah product.",
  "license": "MIT",
  "author": "Arshad Shah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/cynosure.git"
  },
  "homepage": "https://arshad-shah.github.io/cynosure/",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "scripts": {
    "build": "pnpm css && vite build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm css && tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm css && vitest run --project unit --project preact",
    "test:stories": "pnpm css && CY_BROWSERS=chromium,webkit vitest run --project stories --project touch && CY_BROWSERS=firefox vitest run --project stories",
    "test:react18": "pnpm css && pnpm --dir tests/react18 install --frozen-lockfile && vitest run --root tests/react18",
    "test:visual": "pnpm css && VITE_CY_VISUAL=1 CY_BROWSERS=chromium vitest run --project stories",
    "storybook": "pnpm css && storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm css && storybook build",
    "build:site": "pnpm build-storybook --output-dir site/dist/storybook && cp site/index.html site/dist/index.html",
    "size": "size-limit",
    "cy": "node --import tsx tools/cli/index.ts",
    "check": "node --import tsx tools/cli/index.ts check",
    "verify": "pnpm check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:react18 && pnpm test:stories && pnpm coverage && pnpm build && publint && pnpm attw && pnpm size",
    "changeset": "changeset",
    "prepare": "git config --worktree core.hooksPath .githooks 2>/dev/null || git config core.hooksPath .githooks",
    "css": "node --import tsx tools/build-css.ts",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints styles.css 'styles/*.css' 'fonts/*'",
    "coverage": "pnpm css && CY_BROWSERS=chromium vitest run --coverage --project unit --project preact --project stories --project touch"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@arshad-shah/clif": "^1.4.0",
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^3.0.0",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-vitest": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.30.0",
    "playwright": "^1.64.1",
    "preact": "^10.29.8",
    "publint": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "size-limit": "^14.0.0",
    "storybook": "^10.6.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./brands": {
      "types": "./dist/brands/index.d.ts",
      "default": "./dist/brands/index.js"
    },
    "./tokens": {
      "types": "./dist/entries/tokens.d.ts",
      "default": "./dist/entries/tokens.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*.css": "./dist/styles/*.css",
    "./styles.inline": {
      "types": "./dist/styles/inline.d.ts",
      "default": "./dist/styles/inline.js"
    },
    "./vite": {
      "types": "./dist/adapters/vite/index.d.ts",
      "default": "./dist/adapters/vite/index.js"
    },
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@arshad-shah/detent": "^0.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
