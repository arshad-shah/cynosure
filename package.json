{
  "name": "@arshad-shah/cynosure",
  "version": "0.1.0",
  "description": "Cynosure: one small, themeable, accessible UI system for every Arshad Shah product.",
  "license": "MIT",
  "author": "Arshad Shah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/cynosure.git"
  },
  "homepage": "https://arshad-shah.github.io/cynosure/",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "scripts": {
    "build": "node --import tsx tools/build-css.ts && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project stories",
    "test:visual": "CY_VISUAL=1 vitest run --project stories",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "size": "size-limit",
    "cy": "node --import tsx tools/cli/index.ts",
    "check": "node --import tsx tools/cli/index.ts check",
    "verify": "pnpm check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:stories && pnpm build && publint && attw --pack . --profile esm-only && pnpm size",
    "changeset": "changeset",
    "prepare": "git config --worktree core.hooksPath .githooks 2>/dev/null || git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "vitest": "^5.0.0",
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "vite": "^8.0.0",
    "lightningcss": "^1.30.0",
    "tsx": "^4.20.0",
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^3.0.0",
    "publint": "^0.3.0",
    "@arethetypeswrong/cli": "^0.18.0",
    "size-limit": "^14.0.0",
    "@size-limit/preset-small-lib": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*.css": "./dist/styles/*.css",
    "./styles.inline": {
      "types": "./dist/styles/inline.d.ts",
      "default": "./dist/styles/inline.js"
    },
    "./vite": {
      "types": "./dist/adapters/vite/index.d.ts",
      "default": "./dist/adapters/vite/index.js"
    },
    "./package.json": "./package.json"
  }
}
