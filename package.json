{
  "name": "cynosure",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "docs": "pnpm --filter @arshad-shah/cynosure-docs dev",
    "docs:build": "pnpm --filter @arshad-shah/cynosure-docs build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --stats-json",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build --filter=\"./packages/*\" && changeset publish",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "simple-git-hooks",
    "size": "size-limit",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:rtl": "node scripts/audit-rtl.mjs",
    "audit": "pnpm audit:rtl && pnpm audit:contrast",
    "docs:changelog": "node scripts/build-changelog-page.mjs",
    "chromatic": "chromatic --storybook-build-dir=storybook-static --exit-zero-on-changes",
    "brand:generate": "node brand/generate.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@arshad-shah/cynosure-react": "workspace:*",
    "@arshad-shah/cynosure-themes": "workspace:*",
    "@arshad-shah/cynosure-tokens": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/esbuild-plugin": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chromatic": "catalog:",
    "colorjs.io": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.34.5",
    "simple-git-hooks": "catalog:",
    "size-limit": "catalog:",
    "storybook": "catalog:",
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit-msg.mjs $1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": ["biome check --write --no-errors-on-unmatched"]
  },
  "pnpm": {
    "overrides": {
      "yaml@<2.8.3": ">=2.8.3",
      "esbuild@<0.25.0": ">=0.25.0",
      "fast-uri@<3.1.2": ">=3.1.2"
    }
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "10.33.0"
  }
}
