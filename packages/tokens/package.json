{
  "name": "@arshad-shah/cynosure-tokens",
  "version": "1.0.1",
  "description": "Cynosure UI — design tokens (DTCG JSON + generated CSS/TS)",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/css/base.css",
    "./css/dark": "./dist/css/dark.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build:tokens": "node style-dictionary.config.mjs",
    "build": "pnpm validate && pnpm build:tokens && tsup",
    "dev": "pnpm build:tokens && tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated .turbo"
  },
  "devDependencies": {
    "@arshad-shah/cynosure-config": "workspace:*",
    "ajv": "catalog:",
    "glob": "catalog:",
    "style-dictionary": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
