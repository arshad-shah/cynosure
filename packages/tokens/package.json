{
  "name": "@arshad-shah/cynosure-tokens",
  "version": "3.0.0",
  "description": "Cynosure UI — design tokens (DTCG JSON + generated CSS/TS)",
  "license": "MIT",
  "homepage": "https://cynosure.arshadshah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/cynosure.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/arshad-shah/cynosure/issues"
  },
  "keywords": ["cynosure", "design-system", "design-tokens", "dtcg", "css-variables"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/css/base.css",
    "./css/dark": "./dist/css/dark.css",
    "./fonts": "./dist/css/fonts.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build:tokens": "node style-dictionary.config.mjs",
    "build:fonts": "cp src/fonts.css dist/css/fonts.css",
    "build": "pnpm validate && pnpm build:tokens && tsup && pnpm build:fonts",
    "dev": "pnpm build:tokens && pnpm build:fonts && tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated .turbo"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:"
  },
  "devDependencies": {
    "@arshad-shah/cynosure-config": "workspace:*",
    "ajv": "catalog:",
    "glob": "catalog:",
    "style-dictionary": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
