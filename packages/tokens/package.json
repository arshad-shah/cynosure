{
  "name": "@lumen/tokens",
  "version": "0.0.0",
  "description": "Lumen UI — design tokens (DTCG JSON + generated CSS/TS)",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/css/base.css",
    "./css/dark": "./dist/css/dark.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build:tokens": "node style-dictionary.config.mjs",
    "build": "pnpm clean && pnpm validate && pnpm build:tokens && tsup",
    "dev": "pnpm build:tokens && tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated .turbo"
  },
  "devDependencies": {
    "@lumen/config": "workspace:*",
    "ajv": "^8.17.0",
    "glob": "^11.0.0",
    "style-dictionary": "^4.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": { "access": "public" }
}
