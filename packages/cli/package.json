{
  "name": "@arshad-shah/cynosure-cli",
  "version": "1.1.0",
  "description": "Cynosure UI — project scaffolding CLI (npx cynosure init)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cynosure": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@arshad-shah/cynosure-config": "workspace:*",
    "@types/node": "25.6.0",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
