{
  "name": "@arshad-shah/cynosure-icons",
  "version": "3.0.0",
  "description": "Cynosure UI — Lucide React re-exports with tree-shaken bundles",
  "license": "MIT",
  "homepage": "https://cynosure.arshadshah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/cynosure.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/arshad-shah/cynosure/issues"
  },
  "keywords": ["cynosure", "design-system", "icons", "lucide", "react", "svg"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@arshad-shah/cynosure-config": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lucide-react": "catalog:"
  }
}
