{
  "name": "@lumen/themes",
  "version": "0.0.0",
  "description": "Lumen UI — prebuilt themes (default, dark, terminal)",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@lumen/tokens": "workspace:*"
  },
  "devDependencies": {
    "@lumen/config": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": { "access": "public" }
}
