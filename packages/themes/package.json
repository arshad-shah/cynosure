{
  "name": "@lumen/themes",
  "version": "0.1.0",
  "description": "Lumen UI — prebuilt themes (terminal, high-contrast)",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    "./terminal": "./src/terminal/index.css",
    "./high-contrast": "./src/high-contrast/index.css",
    "./package.json": "./package.json"
  },
  "files": ["src", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "echo \"@lumen/themes is CSS-only; nothing to build\"",
    "dev": "echo \"@lumen/themes is CSS-only; nothing to watch\"",
    "typecheck": "echo \"@lumen/themes ships no TypeScript\"",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@lumen/tokens": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
