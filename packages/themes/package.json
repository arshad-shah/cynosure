{
  "name": "@arshad-shah/cynosure-themes",
  "version": "3.0.0",
  "description": "Cynosure UI — prebuilt themes (terminal, high-contrast)",
  "license": "MIT",
  "homepage": "https://cynosure.arshadshah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/cynosure.git",
    "directory": "packages/themes"
  },
  "bugs": {
    "url": "https://github.com/arshad-shah/cynosure/issues"
  },
  "keywords": ["cynosure", "design-system", "themes", "css", "design-tokens"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    "./terminal": "./src/terminal/index.css",
    "./high-contrast": "./src/high-contrast/index.css",
    "./package.json": "./package.json"
  },
  "files": ["src", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "echo \"@arshad-shah/cynosure-themes is CSS-only; nothing to build\"",
    "dev": "echo \"@arshad-shah/cynosure-themes is CSS-only; nothing to watch\"",
    "typecheck": "echo \"@arshad-shah/cynosure-themes ships no TypeScript\"",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@arshad-shah/cynosure-tokens": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
