---
import sizeLimitRaw from '@repo/.size-limit.json';

interface SizeLimitEntry {
  name: string;
  path: string;
  limit: string;
  ignore?: string[];
}

const entries = (sizeLimitRaw as SizeLimitEntry[]).filter(
  (e) => e.name !== 'Full barrel (warning-only)',
);
---

<section data-home-bundle>
  <h2 data-section-heading>Bundle sizes</h2>
  <div data-bundle-table-wrap>
    <table data-bundle-table>
      <thead>
        <tr>
          <th>Component</th>
          <th>Limit (gzip)</th>
        </tr>
      </thead>
      <tbody>
        {entries.map((e) => (
          <tr>
            <td>{e.name}</td>
            <td>{e.limit}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  [data-bundle-table-wrap] {
    overflow-x: auto;
  }
  [data-bundle-table] {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  [data-bundle-table] th,
  [data-bundle-table] td {
    padding: var(--cynosure-space-2, 0.5rem) var(--cynosure-space-3, 0.75rem);
    text-align: left;
    border-bottom: 1px solid var(--cynosure-color-border-subtle, color-mix(in srgb, currentColor 15%, transparent));
  }
  [data-bundle-table] th {
    font-weight: 600;
    color: var(--cynosure-color-foreground-muted, color-mix(in srgb, currentColor 70%, transparent));
  }
  [data-bundle-table] td:last-child {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.85rem;
  }
</style>
