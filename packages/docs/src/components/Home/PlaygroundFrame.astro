---
// Iframe wrapper for the interactive Playground demo.
---
<div data-playground-iframe-wrap>
  <iframe
    src="/demos/playground"
    loading="lazy"
    title="Interactive playground"
    data-playground-iframe
  ></iframe>
</div>

<style>
  [data-playground-iframe-wrap] {
    width: 100%;
    border: 1px solid var(--color-border, color-mix(in srgb, currentColor 15%, transparent));
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
    background: var(--color-surface, transparent);
    margin: var(--space-4, 1rem) 0;
  }
  iframe[data-playground-iframe] {
    width: 100%;
    height: 420px;
    border: 0;
    display: block;
  }
</style>

<script>
  import { subscribeIframeHeight } from '../../lib/ui/iframe-resize';
  const frame = document.querySelector<HTMLIFrameElement>('iframe[data-playground-iframe]');
  if (frame) subscribeIframeHeight(frame, 'playground');
</script>
