---
import sizeLimit from '@repo/.size-limit.json';
import { Badge, Box } from '@arshad-shah/cynosure-react';

interface Props { name: string }
const { name } = Astro.props;

interface SizeLimitEntry { name: string; limit: string; path: string }
const entries = sizeLimit as SizeLimitEntry[];
const entry = entries.find((e) => e.name === name);
---
{entry ? (
  <Box as="span" data-bundle-size>
    <Badge
      variant="outline"
      colorScheme="neutral"
      size="sm"
      shape="pill"
    >{entry.limit}</Badge>
  </Box>
) : null}
