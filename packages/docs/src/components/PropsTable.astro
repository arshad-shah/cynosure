---
import props from '../generated/props.json';
import {
  Table,
  TableHead,
  TableBody,
  TableRow,
  TableHeader,
  TableCell,
  Code,
} from '@arshad-shah/cynosure-react';

interface Props { component: string }
const { component } = Astro.props;

interface PropEntry { name: string; type: string; description: string; required: boolean; defaultValue: string | null }
interface Record { props: PropEntry[] }

const record = (props as globalThis.Record<string, Record>)[component];
if (!record) {
  throw new Error(`PropsTable: component "${component}" not found in props.json. Run 'pnpm generate:props'.`);
}
---
<div data-props-table style="overflow-x:auto;margin:var(--space-4,1rem) 0;">
  <Table variant="line" size="sm">
    <TableHead>
      <TableRow>
        <TableHeader>Prop</TableHeader>
        <TableHeader>Type</TableHeader>
        <TableHeader>Default</TableHeader>
        <TableHeader>Required</TableHeader>
        <TableHeader>Description</TableHeader>
      </TableRow>
    </TableHead>
    <TableBody>
      {record.props.map((p) => (
        <TableRow>
          <TableCell><Code>{p.name}</Code></TableCell>
          <TableCell><Code>{p.type}</Code></TableCell>
          <TableCell>{p.defaultValue ? <Code>{p.defaultValue}</Code> : '—'}</TableCell>
          <TableCell>{p.required ? 'yes' : 'no'}</TableCell>
          <TableCell>{p.description}</TableCell>
        </TableRow>
      ))}
    </TableBody>
  </Table>
</div>
