---
import props from '../generated/props.json';

interface Props { component: string }
const { component } = Astro.props;

interface PropEntry { name: string; type: string; description: string; required: boolean; defaultValue: string | null }
interface Record { props: PropEntry[] }

const record = (props as globalThis.Record<string, Record>)[component];
if (!record) {
  throw new Error(`PropsTable: component "${component}" not found in props.json. Run 'pnpm generate:props'.`);
}
---
<div data-props-table-wrap>
  <table data-props-table>
    <thead>
      <tr>
        <th>Prop</th>
        <th>Type</th>
        <th>Default</th>
        <th>Required</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {record.props.map((p) => (
        <tr>
          <td><code>{p.name}</code></td>
          <td><code>{p.type}</code></td>
          <td>{p.defaultValue ? <code>{p.defaultValue}</code> : '—'}</td>
          <td>{p.required ? 'yes' : 'no'}</td>
          <td>{p.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  [data-props-table-wrap] {
    overflow-x: auto;
    margin: var(--cynosure-space-4, 1rem) 0;
  }
  [data-props-table] code {
    font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: var(--cynosure-radius-sm, 0.25rem);
    background: var(--cynosure-color-background-subtle, color-mix(in srgb, currentColor 6%, transparent));
  }
</style>
