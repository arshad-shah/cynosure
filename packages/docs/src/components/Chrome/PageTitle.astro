---
// Overrides Starlight's default `<PageTitle />` so every component / guide
// page renders its full frontmatter block below the H1:
//
//   1. Lede — the `description` field, with backtick spans rendered as
//      `<code>` so prop / component references aren't leaked as markdown.
//   2. Meta row — `status` pill, `since v…`, `bundleSize`, and `tags`.
//   3. Accessibility note — the `a11y` line as a muted footnote.
//
// Sourcing everything from frontmatter means a component page only needs
// its `---` block to look correct on landing — no manual `<StatusBadge>` /
// `<BundleSizePill>` markup in the MDX body.
//
// `_top` is Starlight's internal page-title anchor id (see
// `@astrojs/starlight/constants` — not a public export, but the value has
// been stable since Starlight 0.x and is referenced by the in-page ToC
// link). Inlining sidesteps a deep-import that Vite refuses to resolve.
const PAGE_TITLE_ID = '_top';

import componentSizes from '../../generated/component-sizes.json';

const { entry, id: routeId } = Astro.locals.starlightRoute;
const data = entry.data;
const description = data.description?.trim();
const status = data.status;
const since = data.since?.trim();
const a11y = data.a11y?.trim();
const tags = (data.tags ?? []).filter((t): t is string => typeof t === 'string' && t.length > 0);

// Resolve the live bundle size from the generated manifest. The component
// page slug (e.g. `components/accordion`) carries the same `accordion`
// slug used as the dist-file basename and the manifest key, so we strip
// the leading `components/` and any trailing `/index` to look it up.
//
// Falls back to the frontmatter `bundleSize` string when no manifest entry
// exists yet — useful for non-component pages (guides, foundations) that
// still want to display a hand-set figure. Frontmatter `bundleSize` is no
// longer the source of truth for component pages.
type SizeEntry = { js: { raw: number; gz: number } | null; css: { raw: number; gz: number } | null };
type ManifestShape = { components: Record<string, SizeEntry> };
const slug = routeId.replace(/^components\//, '').replace(/\/index$/, '');
const manifestEntry = (componentSizes as ManifestShape).components[slug];
function formatBytes(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  return `${(bytes / 1024).toFixed(bytes < 10240 ? 2 : 1)} KB`;
}
let visibleBundleSize: string | null = null;
if (manifestEntry) {
  const total = (manifestEntry.js?.gz ?? 0) + (manifestEntry.css?.gz ?? 0);
  if (total > 0) visibleBundleSize = `${formatBytes(total)} gz`;
} else {
  const fmFallback = data.bundleSize?.trim();
  if (fmFallback && fmFallback !== '—') visibleBundleSize = fmFallback;
}

// Tiny inline-markdown renderer: backtick spans become `<code>` so
// frontmatter descriptions can reference component / prop names
// (e.g. `` `Badge` ``) without leaking the markdown source. HTML-escape
// everything else so descriptions can't smuggle markup.
function renderLedeHtml(input: string): string {
  const escape = (s: string): string =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const parts: string[] = [];
  const re = /`([^`]+)`/g;
  let cursor = 0;
  let match: RegExpExecArray | null;
  // biome-ignore lint/suspicious/noAssignInExpressions: standard regex iteration.
  while ((match = re.exec(input)) != null) {
    if (match.index > cursor) parts.push(escape(input.slice(cursor, match.index)));
    parts.push(`<code>${escape(match[1] ?? '')}</code>`);
    cursor = match.index + match[0].length;
  }
  if (cursor < input.length) parts.push(escape(input.slice(cursor)));
  return parts.join('');
}

const hasMetaRow = Boolean(status || since || visibleBundleSize || tags.length);
---

<h1 id={PAGE_TITLE_ID}>{data.title}</h1>

{description ? <p class="sl-page-lede" set:html={renderLedeHtml(description)} /> : null}

{
  hasMetaRow ? (
    <ul class="sl-page-meta" aria-label="Component metadata">
      {status ? (
        <li class="sl-page-meta-item">
          <span data-status-pill data-status={status}>{status}</span>
        </li>
      ) : null}
      {since ? (
        <li class="sl-page-meta-item sl-page-meta-text">since v{since.replace(/^v/, '')}</li>
      ) : null}
      {visibleBundleSize ? (
        <li class="sl-page-meta-item">
          <span class="sl-page-meta-pill" title="Built JS + CSS transfer size (gzip)">
            {visibleBundleSize}
          </span>
        </li>
      ) : null}
      {tags.map((tag) => (
        <li class="sl-page-meta-item">
          <span class="sl-page-meta-tag">{tag}</span>
        </li>
      ))}
    </ul>
  ) : null
}

{
  a11y ? (
    <p class="sl-page-a11y">
      <span class="sl-page-a11y-label" aria-hidden="true">A11y</span>
      <span set:html={renderLedeHtml(a11y)} />
    </p>
  ) : null
}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }

  /* Lede sits above Starlight's content reset so it stays a subtitle rather
   * than getting styled like a regular body paragraph (no top-margin clash
   * with the H1, slightly larger size, muted colour). */
  .sl-page-lede {
    margin: 0.5rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    max-width: 64ch;
  }
  .sl-page-lede code {
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.95em;
    padding: 0 0.25em;
    border-radius: 0.25em;
    background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.06));
  }

  /* Meta row — horizontal flow of status pill + since + bundle size + tags.
   * Wraps on narrow viewports. Uses unstyled list semantics so SR users get
   * an enumeration but visual users see chips. */
  .sl-page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .sl-page-meta-item {
    display: inline-flex;
    align-items: center;
  }
  .sl-page-meta-text {
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .sl-page-meta-pill,
  .sl-page-meta-tag {
    display: inline-block;
    padding: 0.15em 0.6em;
    border-radius: 9999px;
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.02em;
    border: 1px solid var(--sl-color-gray-5, color-mix(in srgb, currentColor 15%, transparent));
    color: var(--sl-color-gray-2);
    background: transparent;
  }
  .sl-page-meta-tag {
    text-transform: lowercase;
  }

  /* Status pill — uses the same token palette as `<StatusBadge />` so the
   * appearance is identical to what existing pages used to render inline. */
  [data-status-pill] {
    display: inline-block;
    padding: 0.15em 0.6em;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
    border: 1px solid transparent;
  }
  [data-status-pill][data-status='stable'] {
    color: var(--cynosure-color-feedback-success-foreground, #166534);
    background: var(--cynosure-color-feedback-success-soft, #dcfce7);
  }
  [data-status-pill][data-status='beta'] {
    color: var(--cynosure-color-feedback-warning-foreground, #92400e);
    background: var(--cynosure-color-feedback-warning-soft, #fef3c7);
  }
  [data-status-pill][data-status='alpha'] {
    color: var(--cynosure-color-feedback-danger-foreground, #991b1b);
    background: var(--cynosure-color-feedback-danger-soft, #fee2e2);
  }
  [data-status-pill][data-status='experimental'] {
    color: var(--cynosure-color-accent-solid, #4f46e5);
    background: var(--cynosure-color-accent-soft, #eef2ff);
  }
  [data-status-pill][data-status='deprecated'] {
    color: var(--cynosure-color-foreground-muted, #52525b);
    background: var(--cynosure-color-background-subtle, #f4f4f5);
  }

  /* Accessibility footnote — a single-line summary of how the component
   * behaves for assistive tech, sourced from the `a11y` frontmatter field.
   * Sits below the meta row and is muted so it doesn't fight the lede. */
  .sl-page-a11y {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
    max-width: 72ch;
  }
  .sl-page-a11y-label {
    display: inline-block;
    margin-right: 0.4em;
    padding: 0.1em 0.4em;
    font-size: 0.7em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 0.25em;
    background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.06));
    color: var(--sl-color-gray-1);
    vertical-align: middle;
  }
  .sl-page-a11y code {
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.95em;
    padding: 0 0.2em;
    border-radius: 0.25em;
    background: var(--sl-color-gray-6, rgba(255, 255, 255, 0.06));
  }
</style>
