---
---

<div data-search-widget>
  <button type="button" data-search-trigger aria-label="Search docs">
    <span data-search-trigger-icon aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </span>
    <span data-search-trigger-label>Search docs…</span>
    <kbd data-search-kbd>⌘K</kbd>
  </button>

  <dialog data-search-dialog aria-label="Search docs">
    <form method="dialog" data-search-form>
      <div data-search-field>
        <span data-search-field-icon aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </span>
        <input
          type="search"
          data-search-input
          aria-label="Search docs"
          placeholder="Search docs…"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="button" data-search-close aria-label="Close search">Esc</button>
      </div>
      <ul data-search-results aria-live="polite"></ul>
      <p data-search-empty hidden>No results.</p>
      <p data-search-unavailable hidden>
        Search index unavailable. Build docs to enable search.
      </p>
    </form>
  </dialog>
</div>

<style>
  [data-search-widget] {
    flex: 1;
    display: flex;
  }
  [data-search-trigger] {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    font: inherit;
    font-size: 0.875rem;
    padding: 0.4375rem 0.75rem;
    color: var(--cynosure-color-text-muted, color-mix(in srgb, currentColor 70%, transparent));
    background: var(--cynosure-color-surface, transparent);
    border: 1px solid
      var(--cynosure-color-border, color-mix(in srgb, currentColor 15%, transparent));
    border-radius: var(--cynosure-radius-md, 0.5rem);
    cursor: pointer;
    text-align: left;
  }
  [data-search-trigger]:hover {
    background: var(
      --cynosure-color-surface-hover,
      color-mix(in srgb, currentColor 6%, transparent)
    );
  }
  [data-search-trigger]:focus-visible {
    outline: 2px solid var(--cynosure-color-focus, currentColor);
    outline-offset: 2px;
  }
  [data-search-trigger-label] {
    flex: 1;
  }
  [data-search-kbd] {
    font-family: inherit;
    font-size: 0.75rem;
    padding: 0.125rem 0.375rem;
    border: 1px solid
      var(--cynosure-color-border, color-mix(in srgb, currentColor 15%, transparent));
    border-radius: var(--cynosure-radius-sm, 0.375rem);
    background: var(
      --cynosure-color-surface-muted,
      color-mix(in srgb, currentColor 5%, transparent)
    );
    color: inherit;
  }

  [data-search-dialog] {
    padding: 0;
    border: 1px solid
      var(--cynosure-color-border, color-mix(in srgb, currentColor 15%, transparent));
    border-radius: var(--cynosure-radius-lg, 0.75rem);
    background: var(--cynosure-color-bg, canvas);
    color: var(--cynosure-color-text, inherit);
    width: min(640px, 92vw);
    max-height: 80vh;
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.25);
  }
  [data-search-dialog]::backdrop {
    background: rgb(0 0 0 / 0.4);
    backdrop-filter: blur(4px);
  }
  [data-search-form] {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 80vh;
  }
  [data-search-field] {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-bottom: 1px solid
      var(--cynosure-color-border, color-mix(in srgb, currentColor 10%, transparent));
  }
  [data-search-input] {
    flex: 1;
    font: inherit;
    font-size: 1rem;
    padding: 0.25rem 0;
    border: 0;
    outline: none;
    background: transparent;
    color: inherit;
  }
  [data-search-close] {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid
      var(--cynosure-color-border, color-mix(in srgb, currentColor 15%, transparent));
    border-radius: var(--cynosure-radius-sm, 0.375rem);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  [data-search-results] {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
  }
  [data-search-results]:empty {
    display: none;
  }
  [data-search-result] {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.75rem 1rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-bottom: 1px solid
      var(--cynosure-color-border, color-mix(in srgb, currentColor 8%, transparent));
    text-decoration: none;
  }
  [data-search-result]:hover,
  [data-search-result]:focus-visible,
  [data-search-result][aria-selected='true'] {
    background: var(
      --cynosure-color-surface-hover,
      color-mix(in srgb, currentColor 6%, transparent)
    );
    outline: none;
  }
  [data-search-result-title] {
    display: block;
    font-weight: 600;
  }
  [data-search-result-excerpt] {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    opacity: 0.7;
  }
  [data-search-empty],
  [data-search-unavailable] {
    margin: 0;
    padding: 1rem;
    opacity: 0.7;
    font-size: 0.875rem;
  }
</style>

<script>
  import {
    loadPagefind,
    registerSearchHotkey,
    runSearch,
    type PagefindModule,
    type PagefindResult,
  } from '../../lib/ui/search.js';

  function stripTags(input: string): string {
    return input.replace(/<[^>]+>/g, '');
  }

  function initWidget(root: HTMLElement): void {
    if (root.dataset.searchBound === 'true') return;
    root.dataset.searchBound = 'true';

    const trigger = root.querySelector<HTMLButtonElement>('[data-search-trigger]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-search-dialog]');
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const results = root.querySelector<HTMLUListElement>('[data-search-results]');
    const emptyMsg = root.querySelector<HTMLElement>('[data-search-empty]');
    const unavailableMsg = root.querySelector<HTMLElement>('[data-search-unavailable]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-search-close]');

    if (!trigger || !dialog || !input || !results || !emptyMsg || !unavailableMsg || !closeBtn) {
      return;
    }

    let pf: PagefindModule | null = null;
    let pfLoaded = false;
    let debounceTimer: number | undefined;
    let lastQuery = '';

    const ensurePagefind = async (): Promise<void> => {
      if (pfLoaded) return;
      pfLoaded = true;
      pf = await loadPagefind();
      if (!pf) {
        unavailableMsg.hidden = false;
        input.disabled = true;
      }
    };

    const open = (): void => {
      if (!dialog.open) {
        dialog.showModal();
        window.setTimeout(() => input.focus(), 0);
        void ensurePagefind();
      }
    };

    const close = (): void => {
      if (dialog.open) dialog.close();
    };

    const clearResults = (): void => {
      while (results.firstChild) results.removeChild(results.firstChild);
    };

    const renderResults = (items: PagefindResult[]): void => {
      clearResults();
      emptyMsg.hidden = items.length > 0 || lastQuery.trim() === '';
      items.forEach((item, idx) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.setAttribute('data-search-result', '');
        link.href = item.url;
        link.tabIndex = 0;
        if (idx === 0) link.setAttribute('aria-selected', 'true');

        const title = document.createElement('span');
        title.setAttribute('data-search-result-title', '');
        title.textContent = item.meta.title ?? item.url;

        const excerpt = document.createElement('span');
        excerpt.setAttribute('data-search-result-excerpt', '');
        excerpt.textContent = stripTags(item.excerpt);

        link.append(title, excerpt);
        link.addEventListener('click', () => {
          close();
        });
        li.append(link);
        results.append(li);
      });
    };

    const handleInput = (): void => {
      const q = input.value;
      lastQuery = q;
      if (debounceTimer) window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(async () => {
        if (!pf || !q.trim()) {
          renderResults([]);
          return;
        }
        try {
          const items = await runSearch(pf, q);
          renderResults(items);
        } catch {
          renderResults([]);
        }
      }, 150);
    };

    trigger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    input.addEventListener('input', handleInput);

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        const items = Array.from(
          results.querySelectorAll<HTMLElement>('[data-search-result]'),
        );
        if (items.length === 0) return;
        event.preventDefault();
        const active = document.activeElement as HTMLElement | null;
        let idx = items.findIndex((it) => it === active);
        if (idx === -1) idx = 0;
        else idx += event.key === 'ArrowDown' ? 1 : -1;
        idx = (idx + items.length) % items.length;
        items[idx]?.focus();
      }
    });

    registerSearchHotkey(open);
  }

  function init(): void {
    document
      .querySelectorAll<HTMLElement>('[data-search-widget]')
      .forEach((el) => initWidget(el));
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
