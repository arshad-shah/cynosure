---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const src = `/demos/preview/${slug}`;
const channel = `preview:${slug}`;
---
<div data-live-preview-iframe>
  <iframe
    src={src}
    loading="lazy"
    title={`Live demo: ${slug}`}
    data-preview-iframe
    data-channel={channel}
  ></iframe>
</div>

<style>
  [data-live-preview-iframe] {
    width: 100%;
    border: 1px solid var(--color-border, color-mix(in srgb, currentColor 15%, transparent));
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
    background: var(--color-surface, transparent);
  }
  iframe[data-preview-iframe] {
    width: 100%;
    height: 320px;
    border: 0;
    display: block;
  }
</style>

<script>
  import { subscribeIframeHeight } from '../../lib/ui/iframe-resize';
  const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-preview-iframe]');
  frames.forEach((frame) => {
    const channel = frame.dataset.channel;
    if (channel) subscribeIframeHeight(frame, channel);
  });
</script>
