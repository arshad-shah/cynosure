---
import { codeToHtml } from 'shiki';
import { getExample } from '../../lib/example-loader';
import CopyButton from '../CopyButton.astro';
import External from '../icons/External.astro';

interface Props {
  example: string;
  /** Open the code panel by default. Defaults to false (collapsed). */
  defaultOpen?: boolean;
}

const { example, defaultOpen = false } = Astro.props;
const { source, slug } = getExample(example);
const src = `/demos/preview/${slug}`;
const channel = `preview:${slug}`;
const codeHtml = await codeToHtml(source, { lang: 'tsx', theme: 'github-dark-dimmed' });
---
<div data-live data-code-open={defaultOpen ? '' : undefined}>
  <div data-live-toolbar>
    <span data-live-label>Preview</span>

    <div data-live-controls>
      <button type="button" data-live-tool data-live-rtl aria-pressed="false" title="Toggle right-to-left">
        <span>RTL</span>
      </button>

      <div data-live-seg role="group" aria-label="Theme">
        <button
          type="button"
          data-live-tool
          data-live-theme="light"
          aria-pressed="false"
          aria-label="Light theme"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <button
          type="button"
          data-live-tool
          data-live-theme="dark"
          aria-pressed="false"
          aria-label="Dark theme"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
        </button>
      </div>

      <span data-live-sep aria-hidden="true"></span>

      <a
        data-live-tool
        data-live-open-link
        href={src}
        target="_blank"
        rel="noopener"
        aria-label="Open preview in a new tab"
      >
        <span>Open</span>
        <External size={11} />
      </a>
    </div>
  </div>

  <div data-live-stage>
    <iframe
      src={src}
      loading="lazy"
      title={`Live demo: ${slug}`}
      data-preview-iframe
      data-channel={channel}
    ></iframe>
  </div>

  <div data-live-code-bar>
    <button
      type="button"
      data-live-tool
      data-live-code-toggle
      aria-expanded={defaultOpen ? 'true' : 'false'}
      aria-controls={`code-${slug}`}
    >
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        data-live-code-chevron
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
      <span data-live-code-toggle-label>{defaultOpen ? 'Hide code' : 'Show code'}</span>
    </button>
    <span data-live-code-lang>tsx</span>
    <CopyButton code={source} label="Copy" />
  </div>

  <div data-live-code id={`code-${slug}`} hidden={!defaultOpen}>
    <Fragment set:html={codeHtml} />
  </div>
</div>

<style>
  [data-live-stage] iframe[data-preview-iframe] {
    width: 100%;
    height: 220px;
    border: 0;
    display: block;
  }
</style>

<script>
  import { subscribeIframeHeight } from '../../lib/ui/iframe-resize';

  interface FrameState {
    base: string;
    rtl: boolean;
    theme: string | null;
  }

  function applyState(iframe: HTMLIFrameElement, state: FrameState): void {
    const url = new URL(state.base, window.location.origin);
    if (state.rtl) url.searchParams.set('rtl', '1');
    else url.searchParams.delete('rtl');
    if (state.theme) url.searchParams.set('theme', state.theme);
    else url.searchParams.delete('theme');
    iframe.src = url.pathname + url.search;
  }

  document.querySelectorAll<HTMLElement>('[data-live]').forEach((root) => {
    const iframe = root.querySelector<HTMLIFrameElement>('iframe[data-preview-iframe]');
    if (!iframe) return;
    const state: FrameState = { base: iframe.getAttribute('src') ?? '', rtl: false, theme: null };

    root.querySelector<HTMLButtonElement>('[data-live-rtl]')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      state.rtl = !state.rtl;
      btn.setAttribute('aria-pressed', String(state.rtl));
      btn.toggleAttribute('data-active', state.rtl);
      applyState(iframe, state);
    });

    root.querySelectorAll<HTMLButtonElement>('[data-live-theme]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.getAttribute('data-live-theme');
        state.theme = state.theme === next ? null : next;
        root.querySelectorAll<HTMLButtonElement>('[data-live-theme]').forEach((b) => {
          const on = b === btn && state.theme !== null;
          b.toggleAttribute('data-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        applyState(iframe, state);
      });
    });

    const toggle = root.querySelector<HTMLButtonElement>('[data-live-code-toggle]');
    const panel = root.querySelector<HTMLDivElement>('[data-live-code]');
    const label = toggle?.querySelector<HTMLElement>('[data-live-code-toggle-label]');
    toggle?.addEventListener('click', () => {
      if (!panel) return;
      const willOpen = panel.hasAttribute('hidden');
      panel.toggleAttribute('hidden', !willOpen);
      toggle.setAttribute('aria-expanded', String(willOpen));
      root.toggleAttribute('data-code-open', willOpen);
      if (label) label.textContent = willOpen ? 'Hide code' : 'Show code';
    });
  });

  const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-preview-iframe]');
  frames.forEach((frame) => {
    const channel = frame.dataset.channel;
    if (channel) subscribeIframeHeight(frame, channel);
  });
</script>
