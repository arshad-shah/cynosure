---
import { codeToHtml } from 'shiki';
import { getExample } from '../../lib/example-loader';
import CopyButton from '../CopyButton.astro';
import External from '../icons/External.astro';

interface Props {
  example: string;
  /** Open the code panel by default. Defaults to false (collapsed). */
  defaultOpen?: boolean;
  /**
   * Minimum height of the preview stage in pixels. The iframe auto-resizes to
   * its content via `subscribeIframeHeight`; this acts as the lower bound so
   * tiny demos (a single Button) still have breathing room.
   */
  minHeight?: number;
  /**
   * Maximum height of the preview stage in pixels. Use for demos that grow
   * arbitrarily tall (long Tree, scrolling lists). The iframe scrolls inside.
   */
  maxHeight?: number;
}

const { example, defaultOpen = false, minHeight = 120, maxHeight } = Astro.props;
const { source, slug } = getExample(example);
const src = `/demos/preview/${slug}`;
const channel = `preview:${slug}`;
const stageStyle = [
  `--preview-min-h: ${minHeight}px`,
  maxHeight ? `--preview-max-h: ${maxHeight}px` : null,
]
  .filter(Boolean)
  .join('; ');
const codeHtml = await codeToHtml(source, {
  lang: 'tsx',
  themes: { light: 'github-light', dark: 'github-dark' },
  defaultColor: false,
});
---
<div data-live data-code-open={defaultOpen ? '' : undefined}>
  <div data-live-toolbar>
    <span data-live-label>Preview</span>

    <div data-live-controls>
      <button
        type="button"
        data-live-tool
        data-live-rtl
        aria-pressed="false"
        title="Toggle right-to-left"
      >
        <span>RTL</span>
      </button>

      <span data-live-sep aria-hidden="true"></span>

      <a
        data-live-tool
        data-live-open-link
        href={src}
        target="_blank"
        rel="noopener"
        aria-label="Open preview in a new tab"
      >
        <span>Open</span>
        <External size={11} />
      </a>
    </div>
  </div>

  <div data-live-stage style={stageStyle}>
    <iframe
      src={src}
      loading="lazy"
      title={`Live demo: ${slug}`}
      data-preview-iframe
      data-channel={channel}
    ></iframe>
  </div>

  <div data-live-code-bar>
    <button
      type="button"
      data-live-tool
      data-live-code-toggle
      aria-expanded={defaultOpen ? 'true' : 'false'}
      aria-controls={`code-${slug}`}
    >
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        data-live-code-chevron
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
      <span data-live-code-toggle-label>{defaultOpen ? 'Hide code' : 'Show code'}</span>
    </button>
    <span data-live-code-lang>tsx</span>
    <CopyButton code={source} label="Copy" />
  </div>

  <div data-live-code id={`code-${slug}`} hidden={!defaultOpen}>
    <Fragment set:html={codeHtml} />
  </div>
</div>

<style>
  /* Stage hugs the iframe — no large gutter. The iframe auto-resizes its own
   * height via `subscribeIframeHeight`; `--preview-min-h` keeps tiny demos
   * (a single Button) from collapsing, and `--preview-max-h` (when supplied)
   * caps tall demos so the embedded scrollbar takes over. */
  [data-live-stage] {
    min-height: var(--preview-min-h, 120px);
    max-height: var(--preview-max-h, none);
  }
  [data-live-stage] iframe[data-preview-iframe] {
    width: 100%;
    /* Height starts at the configured minimum and is grown by the parent
     * script's postMessage listener as the inner content reports its size. */
    height: var(--preview-min-h, 120px);
    max-height: var(--preview-max-h, none);
    border: 0;
    display: block;
    background: transparent;
  }
</style>

<script>
  import { subscribeIframeHeight } from '../../lib/ui/iframe-resize';

  interface FrameState {
    base: string;
    rtl: boolean;
    /** Mirrors `<html data-theme>` on the host page. */
    theme: 'light' | 'dark';
  }

  function readSiteTheme(): 'light' | 'dark' {
    const t = document.documentElement.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyState(iframe: HTMLIFrameElement, state: FrameState): void {
    const url = new URL(state.base, window.location.origin);
    if (state.rtl) url.searchParams.set('rtl', '1');
    else url.searchParams.delete('rtl');
    url.searchParams.set('theme', state.theme);
    const next = url.pathname + url.search;
    if (iframe.getAttribute('src') !== next) iframe.src = next;
  }

  const roots = document.querySelectorAll<HTMLElement>('[data-live]');
  const frames: Array<{ iframe: HTMLIFrameElement; state: FrameState }> = [];

  roots.forEach((root) => {
    const iframe = root.querySelector<HTMLIFrameElement>('iframe[data-preview-iframe]');
    if (!iframe) return;
    const state: FrameState = {
      base: iframe.getAttribute('src') ?? '',
      rtl: false,
      theme: readSiteTheme(),
    };
    frames.push({ iframe, state });
    applyState(iframe, state);

    root.querySelector<HTMLButtonElement>('[data-live-rtl]')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      state.rtl = !state.rtl;
      btn.setAttribute('aria-pressed', String(state.rtl));
      btn.toggleAttribute('data-active', state.rtl);
      applyState(iframe, state);
    });

    const toggle = root.querySelector<HTMLButtonElement>('[data-live-code-toggle]');
    const panel = root.querySelector<HTMLDivElement>('[data-live-code]');
    const label = toggle?.querySelector<HTMLElement>('[data-live-code-toggle-label]');
    toggle?.addEventListener('click', () => {
      if (!panel) return;
      const willOpen = panel.hasAttribute('hidden');
      panel.toggleAttribute('hidden', !willOpen);
      toggle.setAttribute('aria-expanded', String(willOpen));
      root.toggleAttribute('data-code-open', willOpen);
      if (label) label.textContent = willOpen ? 'Hide code' : 'Show code';
    });
  });

  // Mirror Starlight's theme switcher: watch `<html data-theme>` and update
  // every preview iframe whenever it flips. Also respond to OS-level changes
  // when the user has selected "auto" (Starlight stores no attribute in that
  // case).
  function syncTheme(): void {
    const next = readSiteTheme();
    for (const f of frames) {
      if (f.state.theme === next) continue;
      f.state.theme = next;
      applyState(f.iframe, f.state);
    }
  }
  new MutationObserver(syncTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);

  document.querySelectorAll<HTMLIFrameElement>('iframe[data-preview-iframe]').forEach((frame) => {
    const channel = frame.dataset.channel;
    if (channel) subscribeIframeHeight(frame, channel);
  });
</script>
