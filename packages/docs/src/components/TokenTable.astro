---
import { baseTokens } from '@arshad-shah/cynosure-tokens';
import {
  Code,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@arshad-shah/cynosure-react';

type SupportedGroup = 'color' | 'space' | 'radius' | 'font' | 'shadow' | 'z' | 'duration' | 'easing' | 'line' | 'letter' | 'breakpoint';

interface Props {
  group: SupportedGroup;
  /** Optional sub-key within the group, e.g. group="color" subKey="gray" */
  subKey?: string;
}

const { group, subKey } = Astro.props;

type NestedValue = string | number | { [key: string]: NestedValue };

/** Recursively flatten a nested object into dot-notated key/value pairs */
function flatten(obj: { [key: string]: NestedValue }, prefix = ''): Array<{ name: string; value: string }> {
  const result: Array<{ name: string; value: string }> = [];
  for (const [key, val] of Object.entries(obj)) {
    const fullKey = prefix ? `${prefix}-${key}` : key;
    if (val !== null && typeof val === 'object') {
      result.push(...flatten(val as { [key: string]: NestedValue }, fullKey));
    } else {
      result.push({ name: fullKey, value: String(val) });
    }
  }
  return result;
}

const groupData = (baseTokens as { [key: string]: { [key: string]: NestedValue } })[group];
if (!groupData) {
  throw new Error(`TokenTable: unknown group "${group}". Available: color, space, radius, font, shadow, z, duration, easing, line, letter, breakpoint`);
}

let source: { [key: string]: NestedValue };
if (subKey) {
  const sub = groupData[subKey];
  if (!sub) {
    throw new Error(`TokenTable: unknown subKey "${subKey}" within group "${group}"`);
  }
  source = typeof sub === 'object' && sub !== null ? (sub as { [key: string]: NestedValue }) : { [subKey]: sub };
} else {
  source = groupData as { [key: string]: NestedValue };
}

const rows = flatten(source);
if (rows.length === 0) {
  throw new Error(`TokenTable: group "${group}" is empty`);
}

/** Detect whether a value looks like a CSS color we can swatch */
function isColor(value: string): boolean {
  return /^#|^rgb|^hsl|^oklch/.test(value.trim());
}
---

<Table data-token-table variant="line" size="sm">
  <TableHead>
    <TableRow>
      <TableHeader>Token</TableHeader>
      <TableHeader>Value</TableHeader>
      <TableHeader>Preview</TableHeader>
    </TableRow>
  </TableHead>
  <TableBody>
    {rows.map(({ name, value }) => (
      <TableRow>
        <TableCell><Code>--{group}{subKey ? `-${subKey}` : ''}-{name}</Code></TableCell>
        <TableCell><Code>{value}</Code></TableCell>
        <TableCell>
          {isColor(value)
            ? <span data-swatch style={`background:${value}`} aria-hidden="true"></span>
            : group === 'shadow'
            ? <span data-swatch style={`box-shadow:${value};background:transparent`} aria-hidden="true"></span>
            : null}
        </TableCell>
      </TableRow>
    ))}
  </TableBody>
</Table>

<style>
  [data-token-table] {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  [data-token-table] th,
  [data-token-table] td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border-default, #e4e4e7);
    vertical-align: middle;
  }

  [data-token-table] th {
    font-weight: 600;
    color: var(--color-foreground-muted, #52525b);
    background: var(--color-background-subtle, #f4f4f5);
  }

  [data-token-table] code {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    background: var(--color-background-subtle, #f4f4f5);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    word-break: break-all;
  }

  [data-swatch] {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border-default, #e4e4e7);
    vertical-align: middle;
  }
</style>
