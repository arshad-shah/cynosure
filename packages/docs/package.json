{
  "name": "@arshad-shah/cynosure-docs",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/verify-component-pages.ts && tsx scripts/build-changelog.ts && pnpm run generate:props && pnpm run generate:component-count && astro build && pnpm run build:search && pnpm run sync-search-to-public",
    "preview": "astro preview",
    "generate": "pnpm run generate:props && pnpm run generate:component-count",
    "generate:props": "tsx scripts/generate-props.ts",
    "generate:component-count": "node scripts/component-count.mjs",
    "build:search": "pagefind --site dist",
    "sync-search-to-public": "rm -rf public/pagefind && cp -R dist/pagefind public/pagefind",
    "dev:search": "pnpm run build && echo 'Pagefind now populated in public/pagefind — dev search will work on next astro dev'",
    "check": "astro check && tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .astro node_modules/.astro src/generated"
  },
  "dependencies": {
    "@arshad-shah/cynosure-react": "workspace:*",
    "@arshad-shah/cynosure-themes": "workspace:*",
    "@arshad-shah/cynosure-tokens": "workspace:*",
    "@astrojs/check": "0.9.4",
    "@astrojs/mdx": "4.2.3",
    "@astrojs/react": "4.2.1",
    "@astrojs/sitemap": "3.7.2",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "astro": "5.2.5",
    "glob": "catalog:",
    "lucide-react": "catalog:",
    "pagefind": "1.5.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-docgen-typescript": "2.2.2",
    "tsx": "4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
