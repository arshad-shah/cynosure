{
  "extends": "astro/tsconfigs/strict",
  "include": ["src", "scripts", "tests", ".astro/types.d.ts"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@brand/*": ["../../brand/*"],
      "@docs-root/*": ["../../docs/*"],
      "@repo/*": ["../../*"]
    },
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
