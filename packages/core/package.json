{
  "name": "@arshad-shah/cynosure-core",
  "version": "3.3.0",
  "description": "Cynosure UI — primitives, utilities, hooks",
  "license": "MIT",
  "homepage": "https://cynosure.arshadshah.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arshad-shah/cynosure.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/arshad-shah/cynosure/issues"
  },
  "keywords": ["cynosure", "design-system", "react", "primitives", "hooks", "utilities"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@arshad-shah/cynosure-tokens": "workspace:*"
  },
  "devDependencies": {
    "@arshad-shah/cynosure-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
