{
  "name": "@lumen/react",
  "version": "0.0.0",
  "description": "Lumen UI — React component library",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./box": {
      "types": "./dist/box.d.ts",
      "import": "./dist/box.js"
    },
    "./stack": {
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.js"
    },
    "./inline": {
      "types": "./dist/inline.d.ts",
      "import": "./dist/inline.js"
    },
    "./flex": {
      "types": "./dist/flex.d.ts",
      "import": "./dist/flex.js"
    },
    "./grid": {
      "types": "./dist/grid.d.ts",
      "import": "./dist/grid.js"
    },
    "./center": {
      "types": "./dist/center.d.ts",
      "import": "./dist/center.js"
    },
    "./spacer": {
      "types": "./dist/spacer.d.ts",
      "import": "./dist/spacer.js"
    },
    "./divider": {
      "types": "./dist/divider.d.ts",
      "import": "./dist/divider.js"
    },
    "./aspect-ratio": {
      "types": "./dist/aspectratio.d.ts",
      "import": "./dist/aspectratio.js"
    },
    "./container": {
      "types": "./dist/container.d.ts",
      "import": "./dist/container.js"
    },
    "./section": {
      "types": "./dist/section.d.ts",
      "import": "./dist/section.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "theme",
    "box",
    "stack",
    "inline",
    "flex",
    "grid",
    "center",
    "spacer",
    "divider",
    "aspect-ratio",
    "container",
    "section",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@lumen/core": "workspace:*",
    "@lumen/tokens": "workspace:*",
    "@radix-ui/react-direction": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@lumen/config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
