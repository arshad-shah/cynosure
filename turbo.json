{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "biome.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "tokens/**",
        "scripts/**",
        "package.json",
        "tsconfig.json",
        "tsup.config.ts",
        "style-dictionary.config.mjs"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "tests/**", "vitest.config.*"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@lumen/tokens#typecheck": {
      "dependsOn": ["^build", "build:tokens"],
      "outputs": []
    },
    "@lumen/tokens#build": {
      "dependsOn": ["^build", "build:tokens"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.ts"]
    },
    "build:tokens": {
      "outputs": ["src/generated/**", "dist/css/**"],
      "inputs": ["tokens/**", "scripts/**", "style-dictionary.config.mjs"]
    },
    "clean": { "cache": false }
  }
}
