---
import { getEntry, render } from "astro:content";
import Doc from "../layouts/Doc.astro";

const entry = await getEntry("root", "changelog");
if (!entry) throw new Error("CHANGELOG.md was not loaded");
const { Content } = await render(entry);
---

<Doc title="Changelog" description="Every released version of @arshad-shah/cynosure and what changed in it." current="changelog" source="CHANGELOG.md">
  <Content />
</Doc>
