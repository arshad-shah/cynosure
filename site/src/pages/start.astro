---
import { getEntry, render } from "astro:content";
import { firstParagraph } from "../describe";
import Doc from "../layouts/Doc.astro";

const entry = await getEntry("root", "readme");
if (!entry) throw new Error("README.md was not loaded");
const { Content } = await render(entry);
---

<Doc title="Getting started" description={firstParagraph(entry.body)} current="start" source="README.md">
  <Content />
</Doc>
