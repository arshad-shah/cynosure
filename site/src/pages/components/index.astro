---
import { getEntry } from "astro:content";
import { Card, Grid, Prose, Stack } from "@arshad-shah/cynosure";
import { allEntries, groupsFrom } from "../../catalogue";
import Page from "../../layouts/Page.astro";

const entries = await allEntries();
const byName = new Map(entries.map((e) => [e.name, e]));
const readme = await getEntry("root", "readme");
const groups = groupsFrom(readme?.body ?? "", new Set(byName.keys()));
const grouped = new Set(groups.flatMap((g) => g.names));
const rest = entries.filter((e) => !grouped.has(e.name)).map((e) => e.name);
if (rest.length) groups.push({ label: "More", names: rest });
---

<Page title="Components" description={`All ${entries.length} Cynosure components and foundations, by what they do.`} current="components" source="README.md">
  <Stack gap="8">
    <Prose>
      <h1>Components</h1>
      <p>
        {entries.length} components and foundations. Each page has its usage, props, keyboard behaviour, tokens and the
        products that use it; every one also has live examples in Storybook.
      </p>
    </Prose>
    {
      groups.map((group) => (
        <Stack gap="4" as="section">
          <h2 class="site-group">{group.label}</h2>
          <Grid minItemWidth="16rem" gap="4">
            {group.names.map((name) => {
              const e = byName.get(name)!;
              return (
                <Card href={`/components/${e.slug}/`} variant="outline">
                  <strong class="site-card-title">{e.name}</strong>
                  <span class="site-card-text">{e.summary}</span>
                </Card>
              );
            })}
          </Grid>
        </Stack>
      ))
    }
  </Stack>
</Page>
