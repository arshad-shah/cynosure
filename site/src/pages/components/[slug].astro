---
import { getEntry, render } from "astro:content";
import { Button, Inline } from "@arshad-shah/cynosure";
import { allEntries } from "../../catalogue";
import Doc from "../../layouts/Doc.astro";
import { REPO } from "../../routes";

export async function getStaticPaths() {
  const entries = await allEntries();
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const readme = await getEntry("readmes", entry.id);
if (!readme) throw new Error(`${entry.source} was not loaded`);
const { Content } = await render(readme);
// Storybook ids: "Components/AppShell" → components-appshell.
const stories = `/storybook/?path=/docs/${entry.kind}-${entry.name.toLowerCase()}--docs`;
const folder = `${REPO}/tree/main/src/${entry.kind}/${entry.name}`;
---

<Doc title={entry.name} description={entry.summary.slice(0, 200)} current="components" source={entry.source}>
  <Inline slot="before" gap="3" wrap>
    <Button href={stories} size="sm" variant="outline">Examples in Storybook</Button>
    <Button href={folder} size="sm" variant="ghost">Source</Button>
  </Inline>
  <Content />
</Doc>
