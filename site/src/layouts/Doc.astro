---
import { Prose } from "@arshad-shah/cynosure";
import Page from "./Page.astro";

/** A page made from one repository Markdown file, set in Cynosure's Prose. */
interface Props {
  title: string;
  description: string;
  current: string;
  source: string;
}
const props = Astro.props;
---

<Page {...props}>
  {Astro.slots.has("before") && <div class="site-before"><slot name="before" /></div>}
  <Prose as="article">
    <slot />
  </Prose>
</Page>
