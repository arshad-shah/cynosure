{
  "name": "@arshad-shah/cynosure-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Cynosure documentation site (cynosure.arshadshah.com): a data-driven docs template built with Cynosure from this repository.",
  "scripts": {
    "dev": "pnpm -w build && vite",
    "build": "pnpm -w build && node engine/build/build.ts",
    "preview": "vite preview --port 4321 --strictPort",
    "check": "tsc --noEmit",
    "links": "node engine/build/check-links.ts",
    "sweep": "node engine/build/sweep.ts"
  },
  "dependencies": {
    "@arshad-shah/cynosure": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "playwright": "^1.64.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "vite": "^8.0.0"
  }
}
